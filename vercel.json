{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)keepalive'",
  "crons": [
    {
      "path": "/api/cron/streak",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/prune",
      "schedule": "15 4 * * *"
    }
  ]
}
